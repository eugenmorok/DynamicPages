# DynamicPages CMS — Production конфигурация
# ⚠️ Не коммить this file! Используй .env.example как шаблон.

# ============================================================
# Core
# ============================================================
DEBUG=False
SECRET_KEY=d1*^v3u7^7c_o$#8#y^w&sdrlk*7h&92@c_j74phrfn3&$ptsp
DATABASE_URL=postgres://dynamicpages:secure_password@localhost:5432/dynamicpages_db
ALLOWED_HOSTS=example.com,www.example.com

# ============================================================
# Security
# ============================================================
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================================
# CSP (Content Security Policy)
# ============================================================
CSP_DEFAULT_SRC=('self',)
CSP_SCRIPT_SRC=('self', "'unsafe-inline'",)
CSP_STYLE_SRC=('self', "'unsafe-inline'",)
CSP_IMG_SRC=('self', "data:", "https:", "http:")
CSP_FONT_SRC=('self', "'unsafe-inline'",)
CSP_CONNECT_SRC=('self',)
CSP_MEDIA_SRC=('self',)
CSP_FRAME_SRC=('self',)
CSP_OBJECT_SRC=("none",)
CSP_CHILD_SRC=('self',)
CSP_BASE_URI=('self',)
CSP_FORM_ACTION=('self',)

# ============================================================
# Email
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-app@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@example.com

# ============================================================
# Database
# ============================================================
DB_NAME=dynamicpages_db
DB_USER=dynamicpages_user
DB_PASSWORD=CHANGE_ME!
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# Storage
# ============================================================
STATIC_ROOT=/var/www/dynamicpages/static
MEDIA_ROOT=/var/www/dynamicpages/media
