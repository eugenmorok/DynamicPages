# DynamicPages CMS — Environment Example
# Скопируйте в .env и заполните нужные значения.

# ============================================================
# Core
# ============================================================
DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_HEADER_NAME=HTTP_X_CSRFTOKEN

# ============================================================
# Security (CSP headers)
# ============================================================
CSP_DEFAULT_SRC=('self',)
CSP_SCRIPT_SRC=('self', "'unsafe-inline'",)
CSP_STYLE_SRC=('self', "'unsafe-inline'",)
CSP_IMG_SRC=('self', "data:", "https:", "http:")
CSP_FONT_SRC=('self', "'unsafe-inline'",)
CSP_CONNECT_SRC=('self',)
CSP_MEDIA_SRC=('self',)
CSP_FRAME_SRC=('self',)
CSP_OBJECT_SRC=("none",)
CSP_CHILD_SRC=('self',)
CSP_BASE_URI=('self',)
CSP_FORM_ACTION=('self',)

# ============================================================
# Email
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# ============================================================
# Database (PostgreSQL для production)
# ============================================================
# Укажите DATABASE_URL для PostgreSQL или оставьте пустым для SQLite
# пример: postgres://user:password@localhost:5432/dbname
# DB_NAME=dynamicpages_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
